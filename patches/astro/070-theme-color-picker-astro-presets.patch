-// Create a GM3 chrome color that takes color scheme into account.
-theme_color_picker::mojom::ChromeColorPtr CreateDynamicChromeColor(
-    DynamicColorInfo color_info,
+// This picker serves Astro's Bloom colour presets, not Chromium's GM3
+// palette, and everything in this block exists because the two are different
+// KINDS of thing. A GM3 swatch is a seed colour that ui::GeneratePalette
+// expands at runtime; a Bloom preset is 58 resolved token values per scheme,
+// shipped in chrome/browser/oxy/ui/astro_color_tokens.h and generated from
+// Bloom's own tokens.json. Nothing here computes a colour, which is why
+// ui::GeneratePalette and the kDynamicCustomizeChromeColors table it read are
+// gone from this file.
+
+// Every Astro swatch reports this variant and UpdateTheme reports it for the
+// active preset, because ThemeColorPickerElement::computeSelectedColor_ draws
+// the check mark only when the seed AND the variant match. Bloom has no
+// notion of a Material scheme variant, so the value itself is arbitrary and
+// only has to be the same on both sides; kTonalSpot is the one Chromium
+// treats as its default.
+constexpr ui::mojom::BrowserColorVariant kAstroPresetVariant =
+    ui::mojom::BrowserColorVariant::kTonalSpot;
+
+// The "Grey" swatch means Bloom's grey preset, so that control moves the
+// browser chrome with the rest of the palette instead of turning everything
+// Chromium paints grey around a toolbar that stays whatever colour it was.
+//
+// `gray` and not `mono`, which is the closer match by name and was the first
+// choice here: `mono` is sold with a subscription (ColorPresetGate::kPremium)
+// and Astro is not the one who may hand it out. A palette filtered on the gate
+// while a setter still writes a gated preset is the same defect with a smaller
+// blast radius, so the assertion below is not decoration.
+constexpr astro::ColorPreset kAstroGreyPreset = astro::ColorPreset::kGray;
+static_assert(astro::IsColorPresetOffered(kAstroGreyPreset),
+              "the Grey swatch writes a preset this build does not offer");
+static_assert(astro::IsColorPresetOffered(astro::kDefaultColorPreset),
+              "the Default swatch writes a preset this build does not offer");
+
+// The value that identifies a preset across the Mojo pipe.
+//
+// `seed` is never painted: the swatch renders `foreground`, `background` and
+// `base`, and the page uses `seed` only to decide which swatch is checked and
+// to hand back on a click. It is an IDENTITY, and it is deliberately read
+// from the LIGHT scheme whatever the browser is in, so that a dark-mode
+// toggle cannot leave the identity the page is holding disagreeing with the
+// one UpdateTheme reports.
+//
+// `primary` is the token because it is the preset's brand colour -- the one a
+// user would name if asked what colour "green" is.
+constexpr SkColor AstroPresetSeed(astro::ColorPreset preset) {
+  return astro::ColorTokenValue(preset, astro::ColorScheme::kLight,
+                                astro::ColorToken::kPrimary);
+}
+
+// Two presets sharing an identity would make one of them permanently
+// unreachable: every click on either would resolve to the first, and the
+// check mark would sit on the wrong swatch with nothing reporting it. That is
+// a property of a GENERATED table which a future Bloom release can break, so
+// it is proved here rather than trusted.
+//
+// Scoped to the OFFERED presets, because those are the only ones this picker
+// shows or resolves a click to. Asserting over the whole table would fail on a
+// collision between two colours nobody can reach from here — a gate that stops
+// a build for a defect that does not exist.
+constexpr bool AstroPresetSeedsAreDistinct() {
+  for (size_t a = 0; a < astro::kColorPresetCount; ++a) {
+    if (!astro::IsColorPresetOffered(static_cast<astro::ColorPreset>(a))) {
+      continue;
+    }
+    for (size_t b = a + 1; b < astro::kColorPresetCount; ++b) {
+      if (!astro::IsColorPresetOffered(static_cast<astro::ColorPreset>(b))) {
+        continue;
+      }
+      if (AstroPresetSeed(static_cast<astro::ColorPreset>(a)) ==
+          AstroPresetSeed(static_cast<astro::ColorPreset>(b))) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+static_assert(AstroPresetSeedsAreDistinct(),
+              "two Bloom presets resolve to the same light-scheme `primary`, "
+              "so this picker cannot tell them apart -- choose a different "
+              "identity token in AstroPresetSeed");
+
+std::string_view AstroPresetName(astro::ColorPreset preset) {
+  return astro::kColorPresetNames[static_cast<size_t>(preset)];
+}
+
+// Only ever an OFFERED preset, so a seed the palette never showed -- a
+// renderer sending faircoin's brand colour, say -- resolves to nothing and
+// takes the refusal path with every other unknown seed.
+std::optional<astro::ColorPreset> AstroPresetFromSeed(SkColor seed) {
+  for (size_t index = 0; index < astro::kColorPresetCount; ++index) {
+    const auto preset = static_cast<astro::ColorPreset>(index);
+    if (astro::IsColorPresetOffered(preset) &&
+        AstroPresetSeed(preset) == seed) {
+      return preset;
+    }
+  }
+  return std::nullopt;
+}
+
+// The swatch's label and tooltip. Untranslated on purpose: these are Bloom
+// preset names -- product nouns like "Oxy" and "Faircoin" -- and the set of
+// them comes from a generated table a Bloom release can add to, so a
+// per-preset .grd message id would go stale the first time it did, silently
+// and in the one direction nothing checks.
+std::string AstroPresetLabel(astro::ColorPreset preset) {
+  std::string label(AstroPresetName(preset));
+  if (!label.empty()) {
+    label[0] = base::ToUpperASCII(label[0]);
+  }
+  return label;
+}
+
+// The preset the profile is actually painted with. astro.theme.preset is the
+// authority -- not upstream's GM3 seed -- because the preset can also be
+// changed from astro://settings, which never touches that seed.
+astro::ColorPreset ActiveAstroPreset(Profile* profile) {
+  astro::AstroThemeService* astro_theme =
+      astro::AstroThemeServiceFactory::GetForProfile(profile);
+  if (!astro_theme) {
+    return astro::kDefaultColorPreset;
+  }
+  // GetColorPreset only ever returns a name this build ships.
+  const std::optional<astro::ColorPreset> preset =
+      astro::ColorPresetFromName(astro_theme->GetColorPreset());
+  CHECK(preset.has_value());
+  return *preset;
+}
+
+void StoreAstroPreset(Profile* profile, astro::ColorPreset preset) {
+  astro::AstroThemeService* astro_theme =
+      astro::AstroThemeServiceFactory::GetForProfile(profile);
+  if (!astro_theme) {
+    // A browser context with no Astro theme service (a system profile, say)
+    // has no preset to move. Saying so beats a silent no-op, and beats a
+    // CHECK: nothing here is worth crashing a window over.
+    LOG(ERROR) << "Astro: no theme service for this profile; the colour "
+                  "preset was not changed";
+    return;
+  }
+  // The service refuses a name it does not ship and a preset this build does
+  // not offer, and it is the authority on both -- so this reports rather than
+  // CHECKs. Every path here is reachable from the renderer, and a renderer
+  // must never be able to choose a crash.
+  if (!astro_theme->SetColorPreset(std::string(AstroPresetName(preset)))) {
+    LOG(ERROR) << "Astro: the theme service refused colour preset '"
+               << AstroPresetName(preset)
+               << "'; the picker and astro_theme_service.h disagree about what "
+                  "this build offers";
+  }
+}
+
+// One swatch. The three colours it renders are the three the preset actually
+// paints the browser with, so the swatch is a preview rather than a
+// decoration: the circle is the toolbar, the bottom-left quarter is the brand
+// colour the preset accents with, and the bottom-right quarter is the window
+// frame and the inactive tabs. Which token paints which part of the native UI
+// is decided in chrome/browser/oxy/ui/astro_color_mixer.cc; this repeats three
+// of its choices and invents none.
+theme_color_picker::mojom::ChromeColorPtr CreateAstroPresetColor(
+    astro::ColorPreset preset,
     bool is_dark_mode) {
+  const astro::ColorScheme scheme =
+      is_dark_mode ? astro::ColorScheme::kDark : astro::ColorScheme::kLight;
   auto color = theme_color_picker::mojom::ChromeColor::New();
-  auto color_palette = ui::GeneratePalette(
-      color_info.color, GetSchemeVariant(color_info.variant));
-  color->name = l10n_util::GetStringUTF8(color_info.label_id);
-  color->seed = color_info.color;
-  color->background = is_dark_mode ? color_palette->primary().get(80)
-                                   : color_palette->primary().get(40);
-  color->foreground = is_dark_mode ? color_palette->primary().get(30)
-                                   : color_palette->primary().get(90);
-  color->base = is_dark_mode ? color_palette->secondary().get(50)
-                             : color_palette->primary().get(80);
-  color->variant = color_info.variant;
+  color->name = AstroPresetLabel(preset);
+  color->seed = AstroPresetSeed(preset);
+  // #foreground is the whole circle, #background the bottom-left quarter and
+  // #base the bottom-right one -- see theme_color.html.ts and theme_color.css.
+  color->foreground =
+      astro::ColorTokenValue(preset, scheme, astro::ColorToken::kSurface);
+  color->background =
+      astro::ColorTokenValue(preset, scheme, astro::ColorToken::kPrimary);
+  color->base =
+      astro::ColorTokenValue(preset, scheme, astro::ColorToken::kMuted);
+  color->variant = kAstroPresetVariant;
   return color;
 }
