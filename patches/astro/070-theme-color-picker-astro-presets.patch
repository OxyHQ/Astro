+  theme_service_->SetUserColorAndBrowserColorVariant(seed_color,
+                                                     kAstroPresetVariant);
   theme_service_->UseDeviceTheme(false);
+  StoreAstroPreset(profile_, *preset);
   MaybeIncrementSeedColorChangeCount();
 }
 
