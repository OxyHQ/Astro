diff --git a/chrome/browser/prefs/browser_prefs.cc b/chrome/browser/prefs/browser_prefs.cc
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -1713,6 +1713,49 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry,
   enterprise_connectors::RegisterProfilePrefs(registry);
   enterprise_promotion::RegisterProfilePrefs(registry);
   enterprise_reporting::RegisterProfilePrefs(registry);
+  // Oxy authentication prefs
+  registry->RegisterStringPref("oxy.access_token", "");
+  registry->RegisterStringPref("oxy.refresh_token", "");
+  registry->RegisterStringPref("oxy.session_id", "");
+  registry->RegisterStringPref("oxy.user_id", "");
+  registry->RegisterStringPref("oxy.username", "");
+  registry->RegisterStringPref("oxy.user_avatar", "");
+  registry->RegisterStringPref("oxy.token_expiry", "");
+
+  // Oxy NTP widget visibility prefs
+  registry->RegisterBooleanPref("astro.ntp_show_weather", true);
+  registry->RegisterBooleanPref("astro.ntp_show_clock", true);
+  registry->RegisterBooleanPref("astro.ntp_show_quick_links", true);
+  registry->RegisterBooleanPref("astro.ntp_show_notes", true);
+  registry->RegisterBooleanPref("astro.ntp_show_sites", true);
+  registry->RegisterBooleanPref("astro.ntp_show_discover", true);
+  registry->RegisterBooleanPref("astro.ntp_show_alia", true);
+
+  // The rest of what the new tab page remembers. All three replace a
+  // localStorage key on the page: the browser could not see those, could not
+  // validate a URL before the page rendered it, and each WebUI host being its
+  // own origin meant the note in one window was not the note in another.
+  //
+  // The quick links list is registered EMPTY on purpose. The shipped default
+  // links are in the overlay (kDefaultQuickLinks in
+  // chrome/browser/oxy/webui/astro_ntp_page_handler.cc) and are used only
+  // while the pref IsDefaultValue(), so a user who deletes every link keeps an
+  // empty list instead of having the defaults handed back on next launch.
+  registry->RegisterListPref("astro.ntp_widget_order");
+  registry->RegisterListPref("astro.ntp_quick_links");
+  registry->RegisterStringPref("astro.ntp_notes", "");
+
+  // The active Bloom colour preset, by name. Spelled here as a literal
+  // because a patch edits an upstream file and cannot reach the overlay's
+  // headers; the constant it must equal is astro::prefs::kThemePreset in
+  // chrome/browser/oxy/astro_pref_names.h, and its default is
+  // astro::prefs::kDefaultThemePreset. The third spelling is
+  // THEME_PRESET_PREF in webui/app/src/platform/browser/pref-ids.ts.
+  // tools/tests/cases/theme-pref-ids-match-across-the-boundary.sh is what
+  // keeps the three in agreement — a pref path is a string on every side of
+  // this boundary, so nothing else would notice a rename.
+  registry->RegisterStringPref("astro.theme.preset", "oxy");
+
   dom_distiller::DistilledPagePrefs::RegisterProfilePrefs(registry);
   DownloadPrefs::RegisterProfilePrefs(registry);
 #if BUILDFLAG(ENABLE_GLIC)
