 bool IsInstantNTPURL(const GURL& url, Profile* profile) {
+  // Recognize chrome://astro-ntp as an NTP URL so the URL bar shows
+  // chrome://newtab (displayed as astro://newtab via scheme alias).
+  if (MatchesOrigin(url, GURL(std::string("chrome://") +
+                              oxy::kAstroNtpHost))) {
+    return true;
+  }
   if (MatchesOrigin(url, GURL(chrome::kChromeUINewTabPageURL))) {
     return true;
   }
