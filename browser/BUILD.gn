# The Astro browser-process module.
#
# `astro::CreateExtraParts()` is the single entry point Chromium calls,
# mirroring upstream's own `chrome::AddMetricsExtraParts()` in
# chrome/browser/chrome_browser_main.cc:786. One call, one direction, no
# Chromium behaviour removed.

source_set("browser") {
  sources = [
    "astro_browser_main_extra_parts.cc",
    "astro_browser_main_extra_parts.h",
  ]

  deps = [
    # Astro's WebUI surfaces register themselves from the lifecycle hook in
    # astro_browser_main_extra_parts.cc, so they reach Chromium through the same
    # single entry point everything else does. Nothing in a Chromium-owned file
    # names them.
    "//astro/browser/ui/color",
    "//astro/browser/webui",
    "//base",  # logging, for the startup marker
    "//content/public/browser",
    "//content/public/common",
    "//ui/color",
  ]
}
