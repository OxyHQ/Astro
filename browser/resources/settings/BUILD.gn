# The settings bundle, compiled into the binary as data.
#
# The bundle itself is produced by Vite (`bun run build`) and committed under
# dist/. Building it from GN would be better -- a source change could then not
# ship a stale bundle -- and is deliberately not done yet, because Vite is not
# among the toolchains this checkout vendors. Until it is, dist/ is a checked-in
# input and a stale one is a defect nothing here catches.
action("embedded_resources") {
  script = "//astro/build/embed_resources.py"

  sources = [
    "dist/index.html",
    "dist/settings.css",
    "dist/settings.js",
  ]
  outputs = [ "$target_gen_dir/astro_embedded_resources.cc" ]

  args = [
    "--out",
    rebase_path(outputs[0], root_build_dir),
    "--resource",
    "kAstroSettingsIndexHtml=" + rebase_path("dist/index.html", root_build_dir),
    "--resource",
    "kAstroSettingsJs=" + rebase_path("dist/settings.js", root_build_dir),
    "--resource",
    "kAstroSettingsCss=" + rebase_path("dist/settings.css", root_build_dir),
  ]
}
