# Chromium source (too large for git)
chromium/
depot_tools/
.ungoogled-chromium/

# Build artifacts
releases/
win-sdk/
.xwin/
.xwin-cache/
# Machine-readable reports written by tools/apply-patches.sh and
# tools/sync-overlay.sh (patch-report.json, overlay-manifest.json).
build/
*.tar.gz
*.deb
*.rpm

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
~/.config/

# Python bytecode. A tracked .pyc is rewritten by every suite run, so the
# working tree is never clean — which collides head-on with the --verify-only
# and attributable-tree gates. Worse, the filename encodes the interpreter
# version, so a different Python leaves the tracked file STALE rather than
# rewriting it: it rots silently instead of showing up as a diff.
__pycache__/
*.pyc
