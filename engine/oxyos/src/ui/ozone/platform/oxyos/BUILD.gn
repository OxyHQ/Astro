visibility = [ "//ui/ozone/*" ]

source_set("menu_bar") {
  visibility += [ "//chrome/browser/astro/*" ]
  sources = [
    "oxyos_menu_bar.cc",
    "oxyos_menu_bar.h",
  ]
  deps = [
    "//base",
    "//ui/base",
    "//ui/platform_window",
  ]
}

assert(is_linux)

config("oxyos_client_headers") {
  include_dirs = [ "//third_party/oxyos_client/include" ]
}

source_set("oxyos_client") {
  sources = [ "//third_party/oxyos_client/oxyos_client.o" ]
  public_configs = [ ":oxyos_client_headers" ]
}

source_set("oxyos") {
  sources = [
    "client_native_pixmap_factory_oxyos.cc",
    "client_native_pixmap_factory_oxyos.h",
    "oxyos_canvas_surface.cc",
    "oxyos_canvas_surface.h",
    "oxyos_clipboard.cc",
    "oxyos_clipboard.h",
    "oxyos_configure_queue.cc",
    "oxyos_configure_queue.h",
    "oxyos_connection.cc",
    "oxyos_connection.h",
    "oxyos_conversions.cc",
    "oxyos_conversions.h",
    "oxyos_cursor_factory.cc",
    "oxyos_cursor_factory.h",
    "oxyos_gpu.cc",
    "oxyos_gpu.h",
    "oxyos_input_method_context.cc",
    "oxyos_input_method_context.h",
    "oxyos_keyboard.cc",
    "oxyos_keyboard.h",
    "oxyos_keymap.cc",
    "oxyos_keymap.h",
    "oxyos_screen.cc",
    "oxyos_screen.h",
    "oxyos_surface_factory.cc",
    "oxyos_surface_factory.h",
    "oxyos_surface_host.cc",
    "oxyos_surface_host.h",
    "oxyos_text_input.cc",
    "oxyos_text_input.h",
    "oxyos_vsync.cc",
    "oxyos_vsync.h",
    "oxyos_window.cc",
    "oxyos_window.h",
    "ozone_platform_oxyos.cc",
    "ozone_platform_oxyos.h",
  ]

  defines = [ "OZONE_IMPLEMENTATION" ]

  configs += [ "//ui/events/ozone/layout:xkbcommon" ]

  public_deps = [
    ":menu_bar",
    ":oxyos_client",
  ]

  deps = [
    "mojom",
    "//base",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//skia",
    "//ui/base",
    "//ui/base/clipboard:clipboard_types",
    "//ui/base/cursor",
    "//ui/base/cursor/mojom:cursor_type",
    "//ui/base/ime",
    "//ui/base/ime/linux",
    "//ui/display",
    "//ui/events",
    "//ui/events:dom_keycode_converter",
    "//ui/events/keycodes:xkb",
    "//ui/events/ozone/layout",
    "//ui/events/platform",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/ozone:ozone_base",
    "//ui/ozone/common",
    "//ui/platform_window",
    "//ui/platform_window/wm",
  ]
}

source_set("oxyos_unittests") {
  testonly = true
  sources = [
    "oxyos_clipboard_unittest.cc",
    "oxyos_configure_queue_unittest.cc",
    "oxyos_conversions_unittest.cc",
    "oxyos_keyboard_unittest.cc",
    "oxyos_keymap_unittest.cc",
    "oxyos_menu_bar_unittest.cc",
    "oxyos_screen_unittest.cc",
    "oxyos_text_input_unittest.cc",
  ]
  configs += [ "//ui/events/ozone/layout:xkbcommon" ]
  deps = [
    ":oxyos",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
    "//ui/base/cursor/mojom:cursor_type",
    "//ui/events",
    "//ui/base/ime",
    "//ui/base/ime/linux",
    "//ui/events:dom_keycode_converter",
    "//ui/events/keycodes:xkb",
    "//ui/events/ozone/layout",
    "//skia",
    "//ui/gfx/geometry",
    "//ui/gfx/range",
    "//ui/display",
    "//ui/platform_window/stub",
  ]
}
