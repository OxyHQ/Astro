  }

  if (use_aura) {
    deps += [ "//ui/aura" ]
  }
}

if (!is_mac) {
  _ui_dir = "//chrome/browser/resources/astro_ui"

  generate_grd("build_ui_grd") {
    grd_prefix = "astro_ui"
    out_grd = "$target_gen_dir/astro_ui_resources.grd"
    input_files = read_file("$_ui_dir/files.json", "json")
    input_files_base_dir = rebase_path("$_ui_dir/dist", "//")
  }

  grit("ui_resources") {
    enable_input_discovery_for_gn_analyze = false
    source = "$target_gen_dir/astro_ui_resources.grd"
    deps = [ ":build_ui_grd" ]
    outputs = [
      "grit/astro_ui_resources.h",
      "grit/astro_ui_resources_map.cc",
      "grit/astro_ui_resources_map.h",
      "astro_ui_resources.pak",
    ]
    output_dir = "$root_gen_dir/chrome"
  }
}

config("exports_config") {
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("ac_engine.exports", root_build_dir) ]
}

group("exports") {
  if (is_mac) {
    all_dependent_configs = [ ":exports_config" ]
  }
  public_deps = [ ":astro" ]
}
