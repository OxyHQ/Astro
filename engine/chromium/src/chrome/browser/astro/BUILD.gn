import("//build/config/ui.gni")

assert(is_mac || is_linux || is_win)

source_set("astro") {
  sources = [
    "ac_autofill.cc",
    "ac_autofill.h",
    "ac_bookmarks.cc",
    "ac_browsing_data.cc",
    "ac_browsing_data.h",
    "ac_cast.cc",
    "ac_chrome_ui.h",
    "ac_cli_token_policy.cc",
    "ac_cli_token_policy.h",
    "ac_cookies.cc",
    "ac_cookies.h",
    "ac_device_chooser.cc",
    "ac_display_media.cc",
    "ac_display_media.h",
    "ac_documents.cc",
    "ac_documents.h",
    "ac_downloads.cc",
    "ac_downloads.h",
    "ac_engine.cc",
    "ac_engine.h",
    "ac_engine_webui.cc",
    "ac_engine_webui.h",
    "ac_host.h",
    "ac_extension_actions.cc",
    "ac_extension_actions.h",
    "ac_extension_prompts.cc",
    "ac_extension_views.cc",
    "ac_extension_views.h",
    "ac_extensions.cc",
    "ac_external_app_prompts.cc",
    "ac_extensions.h",
    "ac_extensions_sync.cc",
    "ac_extensions_sync.h",
    "ac_external_apps.h",
    "ac_favicons.cc",
    "ac_history.cc",
    "ac_input_frame_rate.h",
    "ac_memory.cc",
    "ac_omnibox.cc",
    "ac_omnibox.h",
    "ac_passwords.cc",
    "ac_password_prompt.cc",
    "ac_passwords.h",
    "ac_import.cc",
    "ac_import.h",
    "ac_permission_prompts.cc",
    "ac_process.cc",
    "ac_process.h",
    "ac_profile_tabs.cc",
    "ac_profile_tabs.h",
    "ac_reauth.h",
    "ac_scripts_policy.h",
    "ac_search_engines.cc",
    "ac_search_engines.h",
    "ac_sensitive_args.cc",
    "ac_sensitive_args.h",
    "ac_site_settings.cc",
    "ac_site_settings.h",
    "ac_sync_files.cc",
    "ac_sync_files.h",
    "ac_tab_restore.cc",
    "ac_system.cc",
    "ac_system.h",
    "ac_tab_bridge.cc",
    "ac_tab_bridge.h",
    "ac_tabs.cc",
    "ac_tabs.h",
    "ac_ui_source.cc",
    "ac_ui_source.h",
    "ac_window_keys.cc",
    "ac_window_keys.h",
    "ac_zoom.cc",
    "ac_zoom.h",
    "pip/ac_pip_controls.cc",
    "pip/ac_pip_controls.h",
    "pip/ac_pip_mac.h",
    "pip/ac_pip_window.cc",
    "pip/ac_pip_window.h",
    "public/ac_engine.h",
  ]

  deps = [
    "//base",
    "//cc/paint",
    "//chrome/app:generated_resources",
    "//chrome/browser",
    "//chrome/browser/autofill",
    "//chrome/browser/browsing_data:constants",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/browser/device_reauth",
    "//chrome/browser/devtools",
    "//chrome/browser/download",
    "//chrome/browser/extensions",
    "//chrome/browser/extensions/api/passwords_private",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/performance_manager/public/user_tuning",
    "//chrome/browser/picture_in_picture",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search_engines",
    "//chrome/browser/task_manager",
    "//chrome/browser/ui",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/browser/ui/views/overlay",
    "//chrome/common",
    "//chrome/common/extensions/api",
    "//components/autofill/core/browser",
    "//components/autofill/core/common",
    "//components/blocked_content",
    "//components/bookmarks/browser",
    "//components/bookmarks/common",
    "//components/browsing_data/core",
    "//components/component_updater",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/crx_file",
    "//components/device_reauth",
    "//components/download/content/public",
    "//components/download/public/common:public",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/favicon/content",
    "//components/find_in_page",
    "//components/guest_contents/browser",
    "//components/input",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    "//components/media_router/browser",
    "//components/media_router/common",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/os_crypt/common:switches",
    "//components/password_manager/core/browser",
    "//components/password_manager/core/common",
    "//components/performance_manager",
    "//components/permissions",
    "//components/prefs",
    "//components/zoom",
    "//components/search_engines",
    "//components/sessions",
    "//components/strings",
    "//components/update_client",
    "//components/version_info",
    "//components/tab_groups",
    "//components/tabs:public",
    "//content/public/browser",
    "//content/public/common",
    "//crypto",
    "//extensions/browser",
    "//extensions/common",
    "//net",
    "//services/media_session/public/cpp",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//skia",
    "//sql",
    "//third_party/blink/public/common",
    "//third_party/boringssl",
    "//ui/base",
    "//ui/display",
    "//ui/events:dom_keycode_converter",
    "//ui/gfx",
    "//ui/shell_dialogs",
    "//ui/views",
    "//url",
  ]

  if (is_mac) {
    sources += [
      "ac_external_apps.mm",
      "ac_input_frame_rate.mm",
      "ac_reauth.cc",
      "pip/ac_pip_mac.mm",
    ]
    frameworks = [
      "AppKit.framework",
      "QuartzCore.framework",
      "Security.framework",
    ]
  } else {
    sources += [
      "//astro/core/ac_test_media_route_provider.cc",
      "//astro/core/ac_test_media_route_provider.h",
      "ac_platform_default.cc",
    ]
    deps += [
      "//components/media_router/common/mojom:media_router",
      "//mojo/public/cpp/bindings",
    ]
  }

  if (is_win) {
    sources += [ "ac_reauth.cc" ]
  }

  if (use_aura) {
    deps += [ "//ui/aura" ]
  }

  if (is_posix) {
    sources += [
      "ac_cli_control.cc",
      "ac_scripts_policy.cc",
    ]
  } else {
    sources += [ "ac_platform_win.cc" ]
  }
}

config("exports_config") {
  ldflags = [ "-Wl,-exported_symbols_list," +
              rebase_path("ac_engine.exports", root_build_dir) ]
}

group("exports") {
  if (is_mac) {
    all_dependent_configs = [ ":exports_config" ]
  }
  public_deps = [ ":astro" ]
}
