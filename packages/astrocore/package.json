{
  "name": "@astro-browser/astrocore",
  "version": "0.0.0",
  "private": true,
  "description": "The web engine for React Native macOS via Expo Modules: Chrome's own framework from our patched Chromium with our layer (engine/astrocore), hosting Chrome tabs in the app's views.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "clang++ -std=c++20 -Wall -Werror tests/pip-zoom.test.cc -o \"${TMPDIR:-/tmp}/astrocore-pip-zoom-test\" && \"${TMPDIR:-/tmp}/astrocore-pip-zoom-test\" && clang++ -std=c++20 -Wall -Werror tests/pip-throw.test.cc -o \"${TMPDIR:-/tmp}/astrocore-pip-throw-test\" && \"${TMPDIR:-/tmp}/astrocore-pip-throw-test\""
  },
  "dependencies": {
    "@astro-browser/core": "workspace:*"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
