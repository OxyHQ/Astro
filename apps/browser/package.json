{
  "name": "@astro-browser/browser",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "react-native start",
    "macos": "xcodebuild -workspace macos/Astro.xcworkspace -scheme Astro-macOS -derivedDataPath build -destination 'platform=macOS,arch=arm64' -quiet -configuration Debug && open -n --env ASTRO_DATA_DIR=\"${ASTRO_DATA_DIR:-$HOME/Library/Application Support/Astro Dev}\" build/Build/Products/Debug/Astro.app",
    "pods": "cd macos && pod install",
    "build": "xcodebuild -workspace macos/Astro.xcworkspace -scheme Astro-macOS -derivedDataPath build -destination 'platform=macOS,arch=arm64' -quiet -configuration Release",
    "typecheck": "tsc -p .",
    "test": "node --no-warnings --import ./src/test-loader.mjs --test \"src/**/*.test.mjs\""
  },
  "dependencies": {
    "@alia.onl/sdk": "^22.5.0",
    "@astro-browser/astrocore": "workspace:*",
    "@astro-browser/core": "workspace:*",
    "@astro-browser/import": "workspace:*",
    "@astro-browser/shaders": "workspace:*",
    "@astro-browser/shell": "workspace:*",
    "@astro-browser/sync": "workspace:*",
    "@oxy.so/bloom": "^15.59.0",
    "@oxy.so/core": "^7.2.0",
    "@oxy.so/services": "^13.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/query-async-storage-persister": "5.102.8",
    "@tanstack/query-sync-storage-persister": "5.102.8",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-persist-client": "5.102.8",
    "expo": "~54.0.37",
    "expo-modules-core": "~3.0.29",
    "nativewind": "5.0.0-rc.0",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "2.31.2",
    "react-native-macos": "0.81.9",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "4.3.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-apple": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@tailwindcss/postcss": "4.3.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "tailwindcss": "4.3.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@oxy.so/services"
      ]
    }
  }
}
