---
type Status = "yes" | "part" | "no";
const rows: { item: string; detail: string; status: Status; label?: string }[] = [
  { item: "Engine", detail: "Chromium 155, on Chrome’s own framework.", status: "yes" },
  { item: "Windows", detail: "Chrome’s own, so menus and autofill just work.", status: "yes" },
  { item: "De-Googled", detail: "Google’s background services stripped out.", status: "yes" },
  { item: "H.264 and AAC", detail: "The codecs Chromium leaves out.", status: "yes" },
  { item: "DevTools", detail: "Docked, with device mode. Like Chrome.", status: "yes" },
  { item: "Notarized", detail: "Scanned by Apple. Opens without a warning.", status: "yes" },
  { item: "Passkeys", detail: "Touch ID yes. iCloud Keychain waits on Apple.", status: "part" },
  { item: "Sync", detail: "End-to-end encrypted, through your own iCloud Drive.", status: "yes" },
  { item: "Translate", detail: "On your Mac. Nothing leaves it.", status: "yes", label: "Yes, macOS 26" },
  { item: "Widevine", detail: "Google hasn’t signed off. So no Netflix.", status: "no" },
  { item: "Intel Macs", detail: "Apple Silicon only.", status: "no", label: "No" },
];
const labels: Record<Status, string> = { yes: "Yes", part: "Partly", no: "Not yet" };
---

<section class="engine paint" id="chromium" aria-labelledby="engine-title" data-shot="record">
  <div class="wrap engine-grid">
    <header class="engine-head">
      <p class="label kicker">The engine</p>
      <h2 class="poster" id="engine-title" data-reveal>It’s actually Chromium.</h2>
      <p class="lede" data-reveal style="--i: 1">Not WebKit. Not Electron. Every window is Chrome’s own, so sites, extensions and DevTools behave like they do in Chrome.</p>
    </header>

    <div class="checklist" role="table" aria-label="What Astro does and doesn’t do yet">
      <div class="checklist-top label" role="row">
        <span role="columnheader">Part</span>
        <span role="columnheader">Details</span>
        <span role="columnheader">Status</span>
      </div>
      {
        rows.map((r, i) => (
          <div class:list={["row", r.status]} role="row" data-ticks style={`--i: ${i}`}>
            <span class="item" role="cell">{r.item}</span>
            <span class="detail" role="cell">{r.detail}</span>
            <span class="status label" role="cell">
              <svg class="tick" viewBox="0 0 28 24" width="28" height="24" aria-hidden="true">
                <path
                  pathLength="1"
                  d={r.status === "yes" ? "M3 13.5c2.2 1.4 4.3 3.6 6.4 6.6C13 13 17.6 7.4 25 2.6" : r.status === "part" ? "M3 12.6c6.5-1.4 13.4-1.6 21.6-.4" : "M5 4.4c5.4 4.6 11 10 17.4 16.4M22.6 4c-6.4 4.8-11.6 10.2-17.4 16.8"}
                />
              </svg>
              {r.label ?? labels[r.status]}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .engine {
    --bg: var(--golden-late);
    --dab: var(--forest);
    padding: 0 0 var(--section);
  }
  .engine-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: clamp(40px, 6vw, 80px);
  }
  .engine-head {
    grid-column: 1 / span 5;
    align-self: start;
    position: sticky;
    top: 100px;
  }
  h2 {
    font-size: clamp(2.6rem, 1.2rem + 4vw, 5.6rem);
  }
  .lede {
    margin-top: 28px;
    color: var(--ink-2);
    max-width: 26em;
  }
  .checklist {
    grid-column: 7 / -1;
    border-top: 2px solid var(--ink);
  }
  .checklist-top {
    display: grid;
    grid-template-columns: 10rem 1fr 8rem;
    gap: 16px;
    padding: 10px 0;
    color: var(--ink-2);
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 10rem 1fr 8rem;
    gap: 16px;
    padding: 17px 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .item {
    font-family: var(--poster);
    font-weight: 740;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.05rem;
  }
  .detail {
    color: var(--ink-2);
    font-size: var(--t-small);
    line-height: 1.45;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    align-self: center;
  }
  .tick {
    flex: none;
    overflow: visible;
  }
  .tick path {
    fill: none;
    stroke: var(--forest-deep);
    stroke-width: 3.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .part .tick path {
    stroke: var(--sun-deep);
  }
  .no .tick path {
    stroke: var(--stamp);
    stroke-width: 3;
  }
  .no .item,
  .no .detail {
    opacity: 0.72;
  }
  .no .status {
    color: var(--stamp);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tick path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 520ms cubic-bezier(0.5, 0, 0.2, 1);
      transition-delay: calc(var(--i) * 60ms + 150ms);
    }
    :global(.js) .row:global(.in) .tick path {
      stroke-dashoffset: 0;
    }
    .row:hover .tick path {
      animation: repaint 560ms cubic-bezier(0.5, 0, 0.2, 1);
    }
  }
  @keyframes repaint {
    from {
      stroke-dashoffset: 1;
    }
  }

  @media (max-width: 960px) {
    .engine-head,
    .checklist {
      grid-column: 1 / -1;
      position: static;
    }
  }
  @media (max-width: 600px) {
    .checklist-top {
      display: none;
    }
    .row {
      grid-template-columns: 1fr auto;
      grid-template-areas: "item status" "detail detail";
      row-gap: 6px;
    }
    .item {
      grid-area: item;
    }
    .status {
      grid-area: status;
    }
    .detail {
      grid-area: detail;
    }
  }
</style>

<script>
  const rows = document.querySelectorAll<HTMLElement>("[data-ticks]");
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add("in");
        io.unobserve(e.target);
      }
    },
    { rootMargin: "0px 0px -15% 0px" },
  );
  for (const r of rows) io.observe(r);
</script>
